{
  "display_name": "HireKit",
  "version": "0.1.2",
  "description": "Evidence-first application kit pipeline. Parses a CV into an evidence bank, parses a job into requirements, matches them, generates a kit, and verifies every claim against CV evidence.",
  "host_capabilities": [
    "llm.sample"
  ],
  "tools": [
    {
      "name": "parse_cv",
      "description": "Extract an evidence bank from CV text. Every item must quote the CV.",
      "timeout": 60,
      "parameters": [
        {
          "name": "cv_text",
          "type": "string",
          "description": "The pasted CV text, up to 6,000 words.",
          "required": true
        }
      ]
    },
    {
      "name": "parse_job",
      "description": "Extract requirements and keywords from a job description.",
      "timeout": 45,
      "parameters": [
        {
          "name": "job_text",
          "type": "string",
          "description": "The pasted job description, up to 4,000 words.",
          "required": true
        }
      ]
    },
    {
      "name": "match",
      "description": "Match job requirements to evidence IDs and compute the fit score.",
      "timeout": 45,
      "parameters": [
        {
          "name": "job",
          "type": "object",
          "description": "JobRequirements returned by parse_job.",
          "required": true
        },
        {
          "name": "evidence",
          "type": "object",
          "description": "EvidenceBank returned by parse_cv.",
          "required": true
        }
      ]
    },
    {
      "name": "generate",
      "description": "Write the application kit using only cited evidence IDs.",
      "timeout": 90,
      "parameters": [
        {
          "name": "job",
          "type": "object",
          "description": "JobRequirements returned by parse_job.",
          "required": true
        },
        {
          "name": "matches",
          "type": "object",
          "description": "MatchResult returned by match.",
          "required": true
        },
        {
          "name": "evidence",
          "type": "object",
          "description": "EvidenceBank returned by parse_cv.",
          "required": true
        },
        {
          "name": "answers",
          "type": "array",
          "description": "Optional answers to earlier needs-input questions.",
          "required": false,
          "items": {
            "type": "object"
          }
        },
        {
          "name": "tone",
          "type": "string",
          "description": "Tone instruction for the writer.",
          "required": false,
          "default": "direct, warm, specific"
        },
        {
          "name": "level",
          "type": "string",
          "description": "Seniority level: intern, junior, mid, or senior.",
          "required": false
        }
      ]
    },
    {
      "name": "verify",
      "description": "Check every generated claim against the evidence bank and finalize the kit.",
      "timeout": 60,
      "parameters": [
        {
          "name": "evidence",
          "type": "object",
          "description": "EvidenceBank returned by parse_cv.",
          "required": true
        },
        {
          "name": "job",
          "type": "object",
          "description": "JobRequirements returned by parse_job.",
          "required": true
        },
        {
          "name": "matches",
          "type": "object",
          "description": "MatchResult returned by match.",
          "required": true
        },
        {
          "name": "kit",
          "type": "object",
          "description": "KitDraft returned by generate.",
          "required": true
        }
      ]
    },
    {
      "name": "ping",
      "description": "Smoke-test method.",
      "parameters": []
    }
  ],
  "runtime": {
    "type": "uv",
    "min_version": "0.1.0"
  }
}
